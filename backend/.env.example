# ===================================================================
# OWASP Secure Web App Backend - Konfiguracja Środowiskowa (.env)
# ===================================================================

# Tryb debugowania (True dla środowiska lokalnego, False dla produkcji)
DEBUG=True

# Klucz tajny Django (w produkcji wygeneruj silny, unikalny klucz)
SECRET_KEY=django-insecure-development-secret-key-replace-in-production

# Dozwolone hosty (oddzielone przecinkami)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,0.0.0.0

# Konfiguracja bazy danych MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=fintrackbd
DB_USER=fintrack_user
DB_PASSWORD=fintrack_password_dev_123
DB_HOST=db
DB_PORT=3306

# Adres URL frontendu (CORS i odnośniki w mailach aktywacyjnych)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Konfiguracja wysyłki wiadomości e-mail
# Domyślnie dla testów lokalnych linki aktywacyjne wypisywane są w terminalu/logach:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@fintrack.local

